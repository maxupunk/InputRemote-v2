// A janela.
//
// Uma janela, três telas, e navegação com voltar explícito em vez de abas. O motivo: das três,
// duas são visitadas uma vez na vida (pareamento e preferências) e uma é visitada sempre. Abas
// dariam o mesmo peso às três e fariam o usuário escolher onde olhar; assim ele abre o programa
// e já está onde importa.
//
// Largura fixa: é uma tela de configuração, não um painel. Redimensionar não melhora nada e só
// cria estados de layout que ninguém testou.

import { ScrollView } from "std-widgets.slint";

import { Tema } from "tema.slint";
import { Dados, Acoes, EtapaDoPareamento } from "dados.slint";
import { Botao, Faixa } from "componentes.slint";
import { Inicio } from "inicio.slint";
import { Pareamento } from "pareamento.slint";
import { Preferencias } from "preferencias.slint";
import { SemServico } from "ativacao.slint";

// O Rust só enxerga o que o arquivo de entrada exporta. Sem esta linha, `Dados` e `Acoes`
// existem no Slint e não existem na ponte — que é o único jeito de a janela receber dados.
export { Dados, Acoes, EstadoUi, EtapaDoPareamento } from "dados.slint";
export { CopiaUi, ItemDeCopia } from "copia.slint";
// A janelinha do canto, que o Rust cria e posiciona quando uma cópia começa.
export { Flutuante } from "flutuante.slint";

component Voltar inherits Rectangle {
    callback acionado();

    width: rotulo.preferred-width + Tema.e3;
    height: 28px;
    border-radius: Tema.raio-pequeno;
    background: toque.has-hover ? Tema.superficie-suave : transparent;
    animate background { duration: 120ms; }

    rotulo := Text {
        text: "← Voltar";
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        font-size: Tema.fonte-corpo;
        color: Tema.acao;
    }

    toque := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => {
            root.acionado();
        }
    }
}

export component Janela inherits Window {
    title: "InputRemote";
    // O icone da janela: barra de tarefas no Windows, lancador no Linux. E outro caminho que o
    // icone embutido no `.exe`, que e o que o Explorer usa.
    icon: @image-url("../../../recursos/icone-256.png");
    width: Tema.largura;
    height: 660px;
    background: Tema.fundo;
    default-font-size: Tema.fonte-corpo;

    // 0 inicial, 1 pareamento, 2 preferências.
    property <int> tela: 0;

    /// Volta à tela inicial. O serviço a chama quando o estado muda por fora — por exemplo
    /// quando o par é esquecido enquanto as preferências estão abertas.
    public function mostrar-inicio() {
        root.tela = 0;
    }

    /// Vai para a tela de pareamento. O serviço a chama quando chega um código que esta janela não
    /// pediu: é o outro computador pedindo o pareamento, e a comparação precisa estar na frente.
    public function mostrar-pareamento() {
        root.tela = 1;
    }

    VerticalLayout {
        Rectangle {
            background: Tema.superficie;
            height: 48px;

            HorizontalLayout {
                padding-left: Tema.e4;
                padding-right: Tema.e4;
                spacing: Tema.e3;

                if root.tela != 0 && !Dados.desconectado: Voltar {
                    y: (parent.height - self.height) / 2;
                    acionado => {
                        root.tela = 0;
                    }
                }

                Text {
                    text: root.tela == 0 || Dados.desconectado
                        ? "InputRemote"
                        : (root.tela == 1 ? "Parear computador" : "Preferências");
                    vertical-alignment: center;
                    font-size: Tema.fonte-titulo;
                    font-weight: 600;
                    color: Tema.texto;
                }

                Rectangle { }
            }
        }

        Rectangle {
            height: Tema.traco;
            background: Tema.borda;
        }

        // A demonstração só existe quando pedida. Mesmo assim, avisa: dado inventado sem aviso é
        // mentira, ainda que alguém tenha pedido por ele.
        if Dados.simulado: Rectangle {
            background: Tema.atencao-suave;

            VerticalLayout {
                padding-left: Tema.e4;
                padding-right: Tema.e4;
                padding-top: Tema.e3;

                Faixa {
                    texto: "Modo de demonstração (--simulado): os dados abaixo são inventados. "
                        + "Nada é injetado em computador nenhum.";
                    cor: Tema.atencao;
                    cor-de-fundo: Tema.atencao-suave;
                }
            }
        }

        // Uma ação recusada precisa aparecer onde o olho já está, e precisa dizer o que fazer.
        // Um erro que só existe no log é um erro que o usuário vai reportar como "não funciona".
        if Dados.recado != "": Rectangle {
            background: Tema.fundo;

            VerticalLayout {
                padding-left: Tema.e4;
                padding-right: Tema.e4;
                padding-top: Tema.e3;
                spacing: Tema.e2;

                Faixa {
                    texto: Dados.recado-o-que-fazer == "" ? Dados.recado
                        : Dados.recado + " " + Dados.recado-o-que-fazer;
                    cor: Dados.recado-informativo ? Tema.acao : Tema.ruim;
                    cor-de-fundo: Dados.recado-informativo ? Tema.superficie-suave : Tema.ruim-suave;
                }

                HorizontalLayout {
                    alignment: end;

                    Botao {
                        texto: "Entendi";
                        acionado => {
                            Acoes.descartar-recado();
                        }
                    }
                }
            }
        }

        // Rolagem só na vertical. Sem prender a largura, o Slint dá à área rolável a largura
        // mínima do conteúdo quando ela passa da janela, e um texto sem quebra bastava para os
        // cartões saírem cortados à direita, com uma barra horizontal embaixo.
        rolagem := ScrollView {
            viewport-width: self.visible-width;

            VerticalLayout {
                width: rolagem.visible-width;
                padding: Tema.e4;
                spacing: Tema.e4;

                // Sem o serviço, a janela diz o que aconteceu e o que fazer — e continua tentando
                // por conta própria. Não mostra dado inventado no lugar, nem as telas que dependem
                // dele: quem precisa saber que o serviço não está ali não pode ser enganado por uma
                // tela que parece estar funcionando.
                if Dados.desconectado: SemServico { }

                if !Dados.desconectado && root.tela == 0: Inicio {
                    ir-para-pareamento => {
                        root.tela = 1;
                        Acoes.reiniciar-pareamento();
                        Acoes.procurar();
                    }
                    ir-para-preferencias => {
                        root.tela = 2;
                    }
                }

                if !Dados.desconectado && root.tela == 1: Pareamento {
                    concluir => {
                        root.tela = 0;
                    }
                }

                if !Dados.desconectado && root.tela == 2: Preferencias { }
            }
        }
    }
}
