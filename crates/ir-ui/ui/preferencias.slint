// As preferências.
//
// Cada grupo tem uma frase abaixo dizendo o efeito da escolha. Uma configuração cujo efeito o
// usuário não consegue prever é uma configuração que ele não vai mexer — ou vai mexer errado, o
// que é pior.

import { Tema } from "tema.slint";
import { Dados, Acoes } from "dados.slint";
import { TextEdit } from "std-widgets.slint";
import { EscolhaDeBorda } from "bordas.slint";

import {
    Cartao, Botao, BotaoConfirmado, Dado, Faixa, Selo, Secao, Alternativas,
} from "componentes.slint";

component Grupo inherits VerticalLayout {
    in property <string> titulo;
    in property <string> nota;

    spacing: Tema.e2;

    Secao {
        text: root.titulo;
    }

    @children

    if root.nota != "": Text {
        text: root.nota;
        font-size: Tema.fonte-nota;
        color: Tema.texto-fraco;
        wrap: word-wrap;
    }
}

/// A tela de preferências.
export component Preferencias inherits VerticalLayout {
    /// A política escolhida e ainda não confirmada: -1 nenhuma, senão o índice dela.
    property <int> politica-pedida: -1;

    spacing: Tema.e4;

    Cartao {
        Grupo {
            titulo: "QUEM PODE CONTROLAR";
            nota: Dados.estado.politica-nota;

            // Não há dono do teclado: com "Os dois", qualquer computador vai ao outro pela borda,
            // e mexer no mouse do que está sendo usado traz o controle de volta (ADR-0014).
            Alternativas {
                opcoes: ["Os dois", "Só este", "Só o outro"];
                escolhida: root.politica-pedida >= 0
                    ? root.politica-pedida
                    : Dados.estado.politica;
                escolher(indice) => {
                    // Mudar refaz a conexão: um clique errado não pode derrubar a sessão.
                    if indice != Dados.estado.politica {
                        root.politica-pedida = indice;
                    } else {
                        root.politica-pedida = -1;
                    }
                }
            }

            if root.politica-pedida >= 0: HorizontalLayout {
                spacing: Tema.e2;

                Text {
                    text: "Mudar isto reinicia a conexão com o outro computador.";
                    font-size: Tema.fonte-nota;
                    color: Tema.texto-fraco;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }

                Botao {
                    texto: "Mudar";
                    primario: true;
                    acionado => {
                        Acoes.definir-politica(root.politica-pedida);
                        root.politica-pedida = -1;
                    }
                }

                Botao {
                    texto: "Cancelar";
                    acionado => {
                        root.politica-pedida = -1;
                    }
                }
            }
        }
    }

    // Qualquer um dos dois escolhe de que lado fica o outro, e o outro passa a mostrar a oposta:
    // vale a escolha mais recente (ADR-0014). Sem par não há outro computador para pôr ao lado.
    if Dados.estado.tem-par: Cartao {
        EscolhaDeBorda { }

        // Travar a borda é para quando o ponteiro atravessa sem querer — uma apresentação, um
        // jogo em tela cheia. O atalho continua levando o controle.
        Alternativas {
            opcoes: ["Borda livre", "Borda travada"];
            escolhida: Dados.estado.borda-travada ? 1 : 0;
            escolher(indice) => {
                Acoes.travar-borda(indice == 1);
            }
        }

        Text {
            text: "Mexa no mouse ou no teclado do computador que está sendo usado de longe para "
                + "voltar a usá-lo. Atalhos: Ctrl+Alt+Shift+Espaço leva o controle ao outro "
                + "computador e o traz de volta; Ctrl+Alt+Shift+Esc devolve o controle e solta "
                + "tudo; Ctrl+Alt+End é o Ctrl+Alt+Del do outro computador.";
            font-size: Tema.fonte-nota;
            color: Tema.texto-fraco;
            wrap: word-wrap;
        }
    }

    if Dados.estado.tem-par: Cartao {
        Grupo {
            titulo: "COPIAR E COLAR";
            nota: Dados.estado.copiar-e-colar
                ? "O que você copia (Ctrl+C) num computador fica pronto para colar no outro: texto, "
                    + "imagens e arquivos."
                : "Copiar fica só em cada computador: nada do que se copia aqui vai para o outro, e "
                    + "nada do que se copia lá chega aqui. A pasta compartilhada continua "
                    + "sincronizando.";

            Alternativas {
                opcoes: ["Ligado", "Desligado"];
                escolhida: Dados.estado.copiar-e-colar ? 0 : 1;
                escolher(indice) => {
                    Acoes.copiar-e-colar(indice == 0);
                }
            }
        }
    }

    Cartao {
        Grupo {
            titulo: "MEIO DE CONEXÃO";
            nota: "Automático usa Bluetooth quando ele está disponível, porque o atraso é mais "
                + "constante, e cai para a rede local quando não está. Fixe um meio só para "
                + "testar.";

            Alternativas {
                opcoes: ["Automático", "Bluetooth", "Rede"];
                escolhida: Dados.estado.portador-fixado;
                escolher(indice) => {
                    Acoes.fixar-portador(indice);
                }
            }
        }
    }

    Cartao {
        Grupo {
            titulo: "TELA DE BLOQUEIO";
            nota: Dados.estado.sobre-o-bloqueio + " Exige administrador, e liga também o "
                + "Ctrl+Alt+Del pedido de lá (Ctrl+Alt+End no teclado do outro computador).";

            Alternativas {
                opcoes: ["Não permitir", "Permitir"];
                escolhida: Dados.estado.bloqueio-permitido ? 1 : 0;
                escolher(indice) => {
                    Acoes.permitir-bloqueio(indice == 1);
                }
            }
        }

        HorizontalLayout {
            spacing: Tema.e2;

            Selo {
                texto: Dados.estado.nivel;
                cor: Dados.estado.nivel-suficiente ? Tema.bom : Tema.atencao;
                cor-de-fundo: Dados.estado.nivel-suficiente
                    ? Tema.bom-suave
                    : Tema.atencao-suave;
            }

            Text {
                text: Dados.estado.nivel-explicacao;
                // Quem ocupa a sobra da linha é a explicação, e não o selo.
                horizontal-stretch: 1;
                vertical-alignment: center;
                font-size: Tema.fonte-nota;
                color: Tema.texto-fraco;
                wrap: word-wrap;
            }
        }


    }

    if Dados.estado.tem-par: Cartao {
        Grupo {
            titulo: "BLOQUEAR JUNTOS";
            nota: "Quando este computador bloquear a tela, o outro bloqueia também — ele não fica "
                + "aberto para quem passar por ele.";

            Alternativas {
                opcoes: ["Bloquear os dois", "Só este"];
                escolhida: Dados.estado.bloquear-juntos ? 0 : 1;
                escolher(indice) => {
                    Acoes.bloquear-juntos(indice == 0);
                }
            }
        }
    }

    Cartao {
        Grupo {
            titulo: "ESTE COMPUTADOR";
            nota: "A impressão digital identifica esta instalação. O outro computador mostra a "
                + "mesma coisa depois de pareado, e conferir as duas é como se verifica que a "
                + "conexão é com quem se espera.";

            Dado {
                rotulo: "Nome";
                valor: Dados.estado.este-nome;
            }

            Dado {
                rotulo: "Impressão digital";
                valor: Dados.estado.esta-impressao;
            }
        }
    }

    Cartao {
        Grupo {
            titulo: "ARQUIVOS RECEBIDOS";
            nota: "O que chega fica guardado enquanto o computador está ligado, para você colar. A "
                + "pasta é esvaziada ao iniciar o InputRemote e, durante o uso, o que passou de "
                + "duas semanas e o excesso além de 2 GB saem sozinhos, sempre mantendo as últimas "
                + "cópias. Limpar agora tira tudo — inclusive o que ainda não foi colado.";

            HorizontalLayout {
                spacing: Tema.e2;

                Dado {
                    rotulo: "Ocupado agora";
                    valor: Dados.recebidos;
                }

                Rectangle { }

                Botao {
                    texto: "Abrir a pasta";
                    acionado => {
                        Acoes.abrir-recebidos();
                    }
                }

                BotaoConfirmado {
                    texto-normal: "Limpar agora";
                    texto-de-confirmacao: "Apagar tudo?";
                    habilitado: Dados.recebidos-tem-o-que-limpar;
                    confirmado => {
                        Acoes.limpar-recebidos();
                    }
                }
            }
        }
    }

    Cartao {
        Grupo {
            titulo: "QUANDO ALGO DÁ ERRADO";
            nota: "O relatório traz o meio de conexão, o atraso medido, o motivo da última queda e "
                + "o nível de capacidade. Não traz nada do que foi digitado nem nome de arquivo.";

            if Dados.diagnostico == "": Botao {
                texto: "Mostrar diagnóstico";
                acionado => {
                    Acoes.mostrar-diagnostico();
                }
            }

            // Mostrado num campo selecionável em vez de copiado por um botão. A área de
            // transferência é do sistema, e um programa que escreve nela sem o usuário pedir
            // apaga o que ele tinha lá — num produto que compartilha clipboard, isso seria
            // especialmente indelicado.
            if Dados.diagnostico != "": TextEdit {
                text: Dados.diagnostico;
                read-only: true;
                height: 190px;
                font-size: Tema.fonte-nota;
            }

            if Dados.diagnostico != "": HorizontalLayout {
                spacing: Tema.e2;

                Text {
                    text: "Selecione tudo com Ctrl+A e copie com Ctrl+C.";
                    font-size: Tema.fonte-nota;
                    color: Tema.texto-fraco;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }

                // O relatório é uma foto: depois de reproduzir o problema, a pessoa quer a nova.
                Botao {
                    texto: "Atualizar";
                    acionado => {
                        Acoes.mostrar-diagnostico();
                    }
                }
            }
        }
    }

    if Dados.estado.tem-par: Cartao {
        Grupo {
            titulo: "PAR";
            nota: "Esquecer apaga a chave combinada. Para voltar a usar, os dois lados precisam "
                + "parear de novo e comparar um código novo.";

            BotaoConfirmado {
                texto-normal: "Esquecer " + Dados.estado.par-nome;
                texto-de-confirmacao: "Clique de novo para esquecer";
                confirmado => {
                    Acoes.esquecer-par();
                }
            }
        }
    }

    Rectangle { }
}
