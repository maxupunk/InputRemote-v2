// A tela que responde uma pergunta só: está funcionando, e se não, por quê?
//
// A ordem dos blocos é a ordem em que o usuário quer saber. O estado vem primeiro porque é o
// motivo de ele ter aberto a janela; o impedimento vem logo depois porque é a única coisa que
// ele precisa resolver. A configuração — de que lado fica o outro computador, a borda travada —
// mora em Preferências: quase nunca muda, e aqui só ocupava espaço.

import { Tema } from "tema.slint";
import { Dados, Acoes, Saude } from "dados.slint";
import { Cartao, Botao, BotaoDeSegurar, Selo, Dado, Faixa, Ponto } from "componentes.slint";
import { CartaoDeCopia, ListaDeCopias } from "copia.slint";
import { CartaoDePastas } from "pastas.slint";

/// A tela inicial.
export component Inicio inherits VerticalLayout {
    callback ir-para-pareamento();
    callback ir-para-preferencias();
    callback ir-para-pastas();

    /// Se a lista das últimas cópias está aberta. Fechada por padrão.
    in-out property <bool> mostrar-recentes: false;

    spacing: Tema.e4;

    Cartao {
        HorizontalLayout {
            spacing: Tema.e2;

            Ponto {
                cor: Saude.cor(Dados.estado.saude);
                pulsando: Dados.estado.saude == 1;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: Dados.estado.enlace;
                font-size: Tema.fonte-nota;
                font-weight: 600;
                color: Saude.cor(Dados.estado.saude);
                vertical-alignment: center;
            }

            Rectangle { }

            // O nível de capacidade fica sempre visível, e não escondido em Preferências. É o
            // que decide se o produto vai servir na tela de bloqueio, e descobrir que não
            // serve *com a tela bloqueada na frente* é o pior momento possível.
            Selo {
                texto: Dados.estado.nivel;
                cor: Dados.estado.nivel-suficiente ? Tema.bom : Tema.atencao;
                cor-de-fundo: Dados.estado.nivel-suficiente
                    ? Tema.bom-suave
                    : Tema.atencao-suave;
            }
        }

        Text {
            text: Dados.estado.resumo;
            font-size: Tema.fonte-destaque;
            color: Tema.texto;
            wrap: word-wrap;
        }

        // Uma faixa só, a que mais importa: o que impede o produto, o teclado recusado na tela de
        // bloqueio do outro computador (proteção, e não defeito), ou o Wi-Fi que cochila e faz o
        // mouse pela rede travar em rajadas. Esta última vem com o botão que resolve: sem ele, a
        // pessoa teria de achar sozinha a configuração de energia da placa — e, quando a placa é a
        // do outro computador, ir até ele.
        if Dados.estado.aviso != "": Faixa {
            texto: Dados.estado.aviso;
            cor: Tema.atencao;
            cor-de-fundo: Tema.atencao-suave;
            botao: Dados.estado.aviso-resolvivel ? "Resolver" : "";
            // O custo da escolha, dito antes do clique: a placa acordada gasta mais.
            nota: "A placa fica sempre acordada: gasta um pouco mais de bateria.";
            acionado => {
                Acoes.resolver-economia(Dados.estado.aviso-no-par);
            }
        }

        if Dados.estado.conectado: VerticalLayout {
            spacing: Tema.e2;

            Rectangle {
                height: Tema.traco;
                background: Tema.borda;
            }

            Dado {
                rotulo: "Conexão";
                valor: Dados.estado.portador;
            }

            if Dados.estado.motivo-do-portador != "": Text {
                text: Dados.estado.motivo-do-portador;
                font-size: Tema.fonte-nota;
                color: Tema.texto-fraco;
                wrap: word-wrap;
            }

            // Uma linha que responde "está fazendo algo agora?": cópias e pastas, nos dois
            // sentidos, ou "parado". A cor de ação só quando algo atravessa.
            Dado {
                rotulo: "Tráfego";
                valor: Dados.trafego;
                cor-do-valor: Dados.trafego-ativo ? Tema.acao : Tema.texto-fraco;
            }

            if Dados.estado.latencia != "": Dado {
                rotulo: "Atraso";
                valor: Dados.estado.latencia;
                cor-do-valor: Dados.estado.latencia-boa ? Tema.bom : Tema.atencao;
            }

            // O último minuto, uma barra por segundo: o pico que explica o "travou agora há pouco".
            if Dados.atrasos.length > 1: HorizontalLayout {
                height: 28px;
                spacing: 1px;
                alignment: end;
                accessible-role: text;
                accessible-label: "Atraso do último minuto: " + Dados.estado.latencia;

                for altura in Dados.atrasos: Rectangle {
                    width: 4px;
                    VerticalLayout {
                        alignment: end;
                        Rectangle {
                            height: parent.height * altura;
                            border-radius: 1px;
                            background: altura >= 1.0 ? Tema.atencao : Tema.acao;
                        }
                    }
                }
            }
        }
    }

    // A cópia de arquivos fica logo abaixo do estado: é a única coisa que acontece sozinha
    // enquanto o usuário olha, e a que ele veio conferir quando algo não colou do outro lado.
    if Dados.tem-copia: Cartao {
        CartaoDeCopia {
            copia: Dados.copia;
            cancelar => {
                Acoes.cancelar-copia();
            }
            abrir => {
                Acoes.abrir-recebidos();
            }
        }

        // As últimas cópias ficam atrás de um clique: quem abriu a janela quer saber da atual, e
        // uma lista sempre aberta empurraria o resto da tela para baixo.
        if Dados.copias-recentes.length > 0: HorizontalLayout {
            spacing: Tema.e2;

            Text {
                text: mostrar-recentes ? "▾ Cópias recentes" : "▸ Cópias recentes";
                font-size: Tema.fonte-nota;
                color: Tema.acao;
                vertical-alignment: center;

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        mostrar-recentes = !mostrar-recentes;
                    }
                }
            }

            Rectangle { }
        }

        if mostrar-recentes: ListaDeCopias {
            itens: Dados.copias-recentes;
        }
    }

    // Uma ação em destaque por tela, e ela é sempre a próxima coisa a fazer.
    if !Dados.estado.tem-par: Botao {
        texto: "Parear um computador";
        primario: true;
        acionado => {
            root.ir-para-pareamento();
        }
    }

    // Pausar é pausar de verdade: o outro computador é avisado e ninguém reconecta até alguém
    // retomar. "Encerrar conexão" só derrubava o enlace, e a reconexão voltava em 3 s.
    if Dados.estado.pausado: Botao {
        texto: "Retomar";
        primario: true;
        acionado => {
            Acoes.retomar();
        }
    }

    if Dados.estado.conectado && !Dados.estado.pausado: HorizontalLayout {
        spacing: Tema.e2;

        // Os dois mexem no outro computador, então se seguram: um clique de passagem não pausa
        // nem tranca a tela de ninguém.
        BotaoDeSegurar {
            texto: "Pausar";
            horizontal-stretch: 1;
            acionado => {
                Acoes.encerrar();
            }
        }

        // O Ctrl+Alt+Del de verdade nunca sai deste teclado; o atalho é Ctrl+Alt+End, e o botão
        // é para quem não se lembra dele.
        if Dados.estado.manda: BotaoDeSegurar {
            texto: "Ctrl+Alt+Del no outro";
            horizontal-stretch: 1;
            acionado => {
                Acoes.ctrl-alt-del();
            }
        }
    }

    // As pastas compartilhadas: uma linha, e o caminho para a tela delas. Com par só — sem par não
    // há com quem compartilhar.
    if Dados.estado.tem-par: CartaoDePastas {
        abrir => {
            root.ir-para-pastas();
        }
    }

    Rectangle { }

    HorizontalLayout {
        spacing: Tema.e2;

        Botao {
            texto: "Preferências";
            acionado => {
                root.ir-para-preferencias();
            }
        }

        Rectangle { }
    }
}
