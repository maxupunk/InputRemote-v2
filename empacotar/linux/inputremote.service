[Unit]
Description=InputRemote - compartilha teclado e mouse com outro computador
Documentation=https://github.com/inputremote/inputremote
# A rede e o portador de hoje. Sem ela o servico ate sobe, mas nao acha o par.
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/inputremote-daemon
# Um servico de entrada que morre deixa o outro computador sem controle. Ressobe sozinho, com
# folga suficiente para nao entrar em laco de reinicio se a falha for de configuracao.
Restart=on-failure
RestartSec=3

# O estado pertence a maquina, nao ao usuario (docs/02-arquitetura.md, secao 7). O systemd cria
# as duas pastas com o dono certo, e o servico nao precisa se preocupar com isso.
StateDirectory=inputremote
RuntimeDirectory=inputremote
RuntimeDirectoryMode=0755
Environment=IR_DATA_DIR=/var/lib/inputremote
Environment=RUST_LOG=info

# A injecao acontece por /dev/uinput, que e o caminho que funciona no greeter, na tela de
# bloqueio e no console (docs/06-linux.md, secao 2). E por isso que este servico e privilegiado:
# quem injeta entrada precisa deste dispositivo.
DeviceAllow=/dev/uinput rw
# E para ser a maquina que tem o teclado: a captura le teclado e mouse fisicos em
# /dev/input/event* e os toma (EVIOCGRAB) enquanto o controle esta no par (docs/06-linux.md,
# secao 3.4). So leitura: o EVIOCGRAB funciona assim. Sem esta linha, o DeviceAllow acima nega
# todo o resto, e a captura nao abria nenhum dispositivo -- a maquina virava servidor sem ter o
# que capturar (log 47).
DeviceAllow=char-input r

# Endurecimento do que nao e necessario. Nao ha como ser mais restritivo sem perder o uinput.
NoNewPrivileges=yes
# Somente leitura, e nao invisivel: copiar um arquivo da pasta pessoal e enviar para o par exige
# que o servico o leia (ADR-0011). Quem decide *o que* ele pode ler e o ir-files, que so envia o
# que o proprio usuario que pediu leria (permissao.rs) -- o sandbox so garante que gravar ali
# continua impossivel. Com `yes`, todo Ctrl+C na pasta pessoal falhava como "nao sei enviar".
ProtectHome=read-only
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
