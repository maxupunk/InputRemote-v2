[Desktop Entry]
Type=Application
Name=InputRemote (clipboard)
Comment=Leva o clipboard para o outro computador quando o mouse atravessa a borda
Exec=/usr/bin/inputremote-agent --clipboard
Icon=inputremote
# Sem janela, sem entrada no menu: roda na sessao do usuario enquanto ela existir.
NoDisplay=true
Terminal=false
X-GNOME-Autostart-enabled=true
# Inicia depois do painel, quando o compositor ja responde. Antes disso o wl-clipboard nao tem com
# quem falar.
X-GNOME-Autostart-Phase=Applications
