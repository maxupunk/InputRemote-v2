[Desktop Entry]
Type=Application
Name=InputRemote
GenericName=Teclado e mouse compartilhados
Comment=Compartilha teclado e mouse com outro computador
Icon=inputremote
Exec=inputremote-ui
Terminal=false
Categories=Utility;Settings;HardwareSettings;
Keywords=kvm;teclado;mouse;keyboard;
StartupNotify=true
# O mesmo que a janela declara em `set_xdg_app_id` (ir-ui/src/main.rs), e o mesmo nome deste
# arquivo: e assim que o ambiente grafico liga a janela aberta a este atalho, e mostra o icone.
StartupWMClass=inputremote
