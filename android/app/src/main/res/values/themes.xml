<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Fundo preto desde o primeiro quadro: num OLED, preto é pixel apagado, e o painel passa o dia
      aceso. A cor de verdade vem do Compose (`ui/tema/Tema.kt`); isto só evita o clarão branco
      ao abrir.
    -->
    <style name="Tema.Painel" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
